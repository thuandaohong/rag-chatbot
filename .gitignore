__pycache__/
*.pyc
.venv/
# Node
node_modules/
dist/
# Terraform
.terraform/
*.tfstate
*.tfstate.*
tfplan
infra/build/
# Tài liệu nguồn của KB: có bản quyền, KHÔNG commit (repo public). Upload thẳng lên S3.
sample-data/*.pdf
